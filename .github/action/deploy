name: Build & deploy (dev)

on:
  push:
    branches: [ dev ]

jobs:
  deploy:
    runs-on: ubuntu-latest
    env:
      BUILD_DIR: ${{ secrets.BUILD_DIR || 'dist' }}
    steps:
      - uses: actions/checkout@v4
      - name: Build (replace with your build commands)
        run: |
          if [ -f package.json ]; then npm ci && npm run build --if-present; fi
      - name: Ensure build dir exists
        run: [ -d "${{ env.BUILD_DIR }}" ] || (echo "no build dir" && exit 1)
      - name: Install rsync
        run: sudo apt-get update && sudo apt-get install -y rsync
      - name: Parse host and add to known_hosts
        env:
          SERVER_SSH_TARGET: ${{ secrets.SERVER_SSH_TARGET }}
        run: |
          HOST="$(echo "$SERVER_SSH_TARGET" | sed -E 's/([^@]*@)?([^:]+).*/\2/')"
          mkdir -p ~/.ssh
          ssh-keyscan -H "$HOST" >> ~/.ssh/known_hosts
      - name: Start ssh-agent and add private key
        uses: webfactory/ssh-agent@v0.5.4
        with:
          ssh-private-key: ${{ secrets.BLOG_SSH }}
      - name: Rsync build to server
        env:
          SERVER_SSH_TARGET: ${{ secrets.SERVER_SSH_TARGET }}
          RSYNC_RSH: "ssh -o StrictHostKeyChecking=yes -o UserKnownHostsFile=$HOME/.ssh/known_hosts"
        run: |
          USERHOST="$(echo "$SERVER_SSH_TARGET" | sed -E 's/(.+):.+/\\1/')"
          REMOTEPATH="$(echo "$SERVER_SSH_TARGET" | sed -E 's/.+:(.+)/\\1/')"
          rsync -avz --delete "./${{ env.BUILD_DIR }}/" "${USERHOST}:${REMOTEPATH}/"
